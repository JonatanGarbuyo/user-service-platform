{
  "name": "user-service-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:harness": "vitest run --config vitest.harness.config.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "npm run openapi:generate && git diff --exit-code -- openapi/openapi.json",
    "db:generate": "drizzle-kit generate",
    "preagent:ticket": "tsx scripts/configure-agent-git-identity.ts",
    "agent:ticket": "tsx scripts/agent-ticket.ts",
    "review:cycle": "tsx scripts/review-cycle.ts",
    "review:safe-push": "tsx scripts/safe-push.ts",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260910.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11",
    "wrangler": "4.130.0"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "zod": "4.6.1"
  }
}
